{
  "name": "neural-atlas",
  "version": "0.10.0",
  "private": true,
  "description": "Laboratorio didáctico visual de aprendizaje automático con Vue y TypeScript",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "docs:diagrams": "node scripts/render-diagram-catalog.mjs",
    "docs:wireframes": "node scripts/render-wireframes.mjs",
    "docs:trace": "node scripts/render-rf-traceability.mjs",
    "docs:check": "node scripts/check-docs.mjs && node scripts/render-diagram-catalog.mjs --check && node scripts/render-rf-traceability.mjs --check && node scripts/check-review-fixtures.mjs && node scripts/render-reference-catalog.mjs --check",
    "preview": "vite preview",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run build:check && npm run docs:check",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint src tests *.config.ts public",
    "typecheck": "vue-tsc --noEmit",
    "build:check": "node scripts/check-build.mjs",
    "docs:catalog": "node scripts/render-reference-catalog.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "26.6.5",
    "@types/papaparse": "5.5.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "26.1.0",
    "mermaid": "11.17.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "mermaid": {
      "katex": "0.18.2"
    }
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "papaparse": "5.7.0",
    "pinia": "3.0.4",
    "vue": "3.5.44",
    "vue-router": "4.6.4",
    "zod": "4.6.7"
  }
}
